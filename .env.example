# Odoo JSON/2 (sin ODOO_USER ni ODOO_PASSWORD)
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=contea
ODOO_PROTOCOL=json2
ODOO_API_KEY=cambiar_por_api_key_readonly
ODOO_TIMEOUT_SECONDS=15
ODOO_READONLY_ATTESTED=false
APP_ENV=development

# LLM y embeddings
OPENAI_API_KEY=cambiar_por_api_key_openai
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBEDDING_MODEL=cambiar_por_modelo_embeddings
LLM_TIMEOUT_SECONDS=30

# Corpus, retrieval y resolución de entidades
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=contafis_normativa_v1
BM25_INDEX_PATH=data/bm25_index.json
BM25_INDEX_VERSION=1
RETRIEVAL_DENSE_TOP_K=10
RETRIEVAL_BM25_TOP_K=10
RETRIEVAL_FINAL_TOP_K=5
RRF_K=60
DENSE_MIN_SCORE=0.30
BM25_MIN_SCORE=1.0
RETRIEVAL_TIMEOUT_SECONDS=10
FUZZY_MIN_SCORE=85

# API
API_HOST=127.0.0.1
API_PORT=8000
API_SHARED_SECRET=

# Límites
MAX_MESSAGE_CHARS=2000
MAX_TOOL_CALLS=3
RECURSION_LIMIT=12
DETAIL_LIMIT=50
MEMORY_MAX_TURNS=20
MEMORY_MAX_THREADS=500
SCOPE_CHECK_TTL_SECONDS=300

# LangSmith Tracing (trazas del proyecto LangGraph; NO usar LANGSMITH_AGENT_ID)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="tu_api_key_aqui"
LANGSMITH_PROJECT="contafis-assistant"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
